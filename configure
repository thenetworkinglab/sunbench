#!/bin/sh
# Copyright (C) 2026 thenetworkinglab
# SPDX-License-Identifier: GPL-3.0-or-later  (see LICENSE)
#
# configure -- hand-rolled feature probe for sunbench.
#
# Deliberately NOT autoconf: autoconf is slow, fat, and fragile on a
# SPARCstation 1.  This is ~60 lines of Bourne shell that compiles tiny
# test programs with $CC and writes src/config.h.  Runs fine on the
# /bin/sh that ships with SunOS 4 through Solaris 10.
#
# Override the compiler like:   CC=gcc ./configure
#
CC=${CC:-cc}
CFLAGS=${CFLAGS:-}
OUT=src/config.h
T=./conftest$$

trap 'rm -f ${T} ${T}.c ${T}.o' 0 1 2 3 15

# try: reads a C program on stdin, returns 0 if it compiles AND links.
# We prepend __EXTENSIONS__ so probes see the same (un-hidden) Solaris
# prototypes the real build will, via port.h.
try() {
    { echo '#ifndef __EXTENSIONS__'
      echo '#define __EXTENSIONS__ 1'
      echo '#endif'
      cat; } > ${T}.c
    $CC $CFLAGS -o ${T} ${T}.c "$@" >/dev/null 2>&1
}

emit() { echo "$1" >> $OUT; }
have() { emit "#define $1 1"; echo "  $2: yes"; }
lack() {                       echo "  $2: no"; }

echo "sunbench configure -- probing with CC=$CC"
: > $OUT
emit "/* Generated by ./configure -- do not edit. */"
emit "#ifndef SUNBENCH_CONFIG_H"
emit "#define SUNBENCH_CONFIG_H"

# --- compiler dialect: keep K&R definitions compiling -------------------
# sunbench's function definitions are K&R style, so SunOS 4's bundled cc
# can build it.  C23 removed that syntax: a compiler DEFAULTING to C23
# (GCC 15) rejects the whole tree, and clang warns on every definition.
# Flags found here go to src/config.cflags, which the Makefile's compile
# rule reads with backquotes (portable to every make back to SunOS 4).
XCFLAGS=
cat > ${T}.c <<'EOF'
int f(a) int a; { return a; }
int main() { return f(0); }
EOF
if $CC $CFLAGS -c ${T}.c -o ${T}.o >/dev/null 2>&1; then
    :
elif $CC $CFLAGS -std=gnu17 -c ${T}.c -o ${T}.o >/dev/null 2>&1; then
    XCFLAGS="-std=gnu17"
    CFLAGS="$CFLAGS -std=gnu17"        # later probes must see it too
fi
if $CC $CFLAGS -c ${T}.c -o ${T}.o 2>&1 | grep deprecated-non-prototype >/dev/null; then
    XCFLAGS="$XCFLAGS -Wno-deprecated-non-prototype"
fi
rm -f ${T}.o
XCFLAGS=`echo $XCFLAGS`                # trim the leading blank
echo "$XCFLAGS" > src/config.cflags
if [ -n "$XCFLAGS" ]; then
    echo "  extra compiler flags: $XCFLAGS"
else
    echo "  extra compiler flags: none"
fi

# --- high-resolution monotonic timer (Solaris 2.5+) ---------------------
if try <<'EOF'
#include <sys/time.h>
int main() { hrtime_t t = gethrtime(); return (int)(t & 0); }
EOF
then have HAVE_GETHRTIME "gethrtime (hi-res timer)"
else lack "" "gethrtime (hi-res timer)"; fi

# --- strerror: ANSI libc addition (SunOS 4 has sys_errlist instead) -----
if try <<'EOF'
#include <string.h>
int main() { return strerror(1) != (char *)0 ? 0 : 1; }
EOF
then have HAVE_STRERROR "strerror"
else lack "" "strerror (fallback: sys_errlist)"; fi

# --- Minix: its headers declare POSIX interfaces only on request --------
if try <<'EOF'
#include <minix/config.h>
int main() { return 0; }
EOF
then have HAVE_MINIX "Minix (enable _MINIX/_POSIX_SOURCE)"
else lack "" "Minix"; fi

# --- gettimeofday: microsecond wall clock (everything but Minix 2) ------
if try <<'EOF'
#include <sys/time.h>
int main() { struct timeval tv; return gettimeofday(&tv, (struct timezone *)0); }
EOF
then have HAVE_GETTIMEOFDAY "gettimeofday"
else lack "" "gettimeofday (fallback: times(), clock-tick resolution)"; fi

# --- valloc: page-aligned buffers (BSD + SVR4) --------------------------
if try <<'EOF'
#include <stdlib.h>
int main() { return valloc(4096) == 0; }
EOF
then have HAVE_VALLOC "valloc"
else lack "" "valloc (fallback: malloc)"; fi

# --- fsync --------------------------------------------------------------
if try <<'EOF'
#include <unistd.h>
int main() { return fsync(0); }
EOF
then have HAVE_FSYNC "fsync"
else lack "" "fsync (fallback: sync)"; fi

# --- readlink (Solaris /dev/dsk -> driver instance resolution) ----------
if try <<'EOF'
#include <unistd.h>
int main() { char b[8]; return (int)readlink("x", b, 8); }
EOF
then have HAVE_READLINK "readlink"
else lack "" "readlink"; fi

# --- BSD sockets: the network module's only transport -------------------
if try <<'EOF'
#include <sys/types.h>
#include <sys/socket.h>
#include <netinet/in.h>
int main() { struct sockaddr_in sa; sa.sin_family = AF_INET; return socket(AF_INET, SOCK_STREAM, 0) < 0; }
EOF
then have HAVE_SOCKETS "BSD sockets"
elif try -lsocket -lnsl <<'EOF'
#include <sys/types.h>
#include <sys/socket.h>
#include <netinet/in.h>
int main() { struct sockaddr_in sa; sa.sin_family = AF_INET; return socket(AF_INET, SOCK_STREAM, 0) < 0; }
EOF
then have HAVE_SOCKETS "BSD sockets (via -lsocket -lnsl)"
else lack "" "BSD sockets (network tests unavailable)"; fi

# --- msync(MS_INVALIDATE): purge a file's cached pages (SVR4 + SunOS 4) -
if try <<'EOF'
#include <sys/types.h>
#include <sys/mman.h>
int main() { return msync((char *)0, 0, MS_INVALIDATE); }
EOF
then have HAVE_MSYNC_INV "msync MS_INVALIDATE (cache purge)"
else lack "" "msync MS_INVALIDATE (cache purge)"; fi

# --- posix_fadvise(DONTNEED): cache purge that Linux actually honors ----
if try <<'EOF'
#include <sys/types.h>
#include <fcntl.h>
int main() { return posix_fadvise(0, (off_t)0, (off_t)0, POSIX_FADV_DONTNEED); }
EOF
then have HAVE_FADVISE "posix_fadvise DONTNEED (cache purge)"
else lack "" "posix_fadvise DONTNEED (cache purge)"; fi

# --- F_NOCACHE: per-file cache bypass (macOS), used where no directio --
if try <<'EOF'
#include <fcntl.h>
int main() { return fcntl(0, F_NOCACHE, 1); }
EOF
then have HAVE_F_NOCACHE "fcntl F_NOCACHE (cache bypass)"
else lack "" "fcntl F_NOCACHE (cache bypass)"; fi

# --- directio: page-cache bypass (Solaris 2.6+) -------------------------
if try <<'EOF'
#include <sys/types.h>
#include <sys/fcntl.h>
int main() { return directio(0, 0); }
EOF
then have HAVE_DIRECTIO "directio (cache bypass)"
else lack "" "directio (cache bypass)"; fi

# --- physical memory query (Solaris) ------------------------------------
if try <<'EOF'
#include <unistd.h>
int main() { return (int)sysconf(_SC_PHYS_PAGES); }
EOF
then have HAVE_SC_PHYS_PAGES "sysconf(_SC_PHYS_PAGES)"
else lack "" "sysconf(_SC_PHYS_PAGES)"; fi

# --- physical memory query (4.4BSD: NetBSD etc.) ------------------------
if try <<'EOF'
#include <sys/param.h>
#include <sys/sysctl.h>
int main() { int mib[2]; mib[0] = CTL_HW; mib[1] = HW_PHYSMEM; return mib[1] & 0; }
EOF
then have HAVE_SYSCTL_HW_PHYSMEM "sysctl(HW_PHYSMEM)"
else lack "" "sysctl(HW_PHYSMEM)"; fi

# --- online CPU count, for fork()-based MP mode (Solaris) ---------------
if try <<'EOF'
#include <unistd.h>
int main() { return (int)sysconf(_SC_NPROCESSORS_ONLN); }
EOF
then have HAVE_SC_NPROCESSORS_ONLN "sysconf(_SC_NPROCESSORS_ONLN)"
else lack "" "sysconf(_SC_NPROCESSORS_ONLN)"; fi

# --- O_DSYNC synchronous writes -----------------------------------------
if try <<'EOF'
#include <fcntl.h>
int main() { return O_DSYNC; }
EOF
then have HAVE_O_DSYNC "O_DSYNC (synchronous writes)"
else lack "" "O_DSYNC (synchronous writes)"; fi

# --- statvfs: free space, to cap the test file to the disk (Solaris) ----
if try <<'EOF'
#include <sys/statvfs.h>
int main() { struct statvfs v; return statvfs(".", &v); }
EOF
then have HAVE_STATVFS "statvfs (free-space check)"
else lack "" "statvfs (free-space check)"; fi

# --- struct statvfs.f_basetype: fs type name (Solaris-only) -------------
if try <<'EOF'
#include <sys/statvfs.h>
int main() { struct statvfs v; return (int)v.f_basetype[0]; }
EOF
then have HAVE_F_BASETYPE "statvfs.f_basetype (fs type name)"
else lack "" "statvfs.f_basetype (fs type name)"; fi

# --- statfs, 4.4BSD flavor (NetBSD): free-space fallback ----------------
if try <<'EOF'
#include <sys/param.h>
#include <sys/mount.h>
int main() { struct statfs v; return statfs(".", &v) + (int)v.f_fstypename[0]; }
EOF
then have HAVE_STATFS_MOUNT "statfs <sys/mount.h> (free-space check)"
else lack "" "statfs <sys/mount.h> (free-space check)"; fi

# --- sysctlbyname: model/cpu/clock on macOS and FreeBSD ----------------
if try <<'EOF'
#include <sys/types.h>
#include <sys/sysctl.h>
int main() { char b[64]; size_t n = sizeof(b); return sysctlbyname("hw.model", b, &n, (void *)0, 0); }
EOF
then have HAVE_SYSCTLBYNAME "sysctlbyname (macOS/BSD model, cpu, clock)"
else lack "" "sysctlbyname (macOS/BSD model, cpu, clock)"; fi

# --- statfs, SunOS 4 flavor: free-space fallback ------------------------
if try <<'EOF'
#include <sys/vfs.h>
int main() { struct statfs v; return statfs(".", &v); }
EOF
then have HAVE_STATFS_VFS "statfs <sys/vfs.h> (free-space check)"
else lack "" "statfs <sys/vfs.h> (free-space check)"; fi

# --- sysinfo(SI_PLATFORM): hardware model string (Solaris) --------------
if try <<'EOF'
#include <sys/systeminfo.h>
int main() { char b[8]; return (int)sysinfo(SI_PLATFORM, b, (long)sizeof(b)); }
EOF
then have HAVE_SYSINFO "sysinfo (hardware model)"
else lack "" "sysinfo (hardware model)"; fi

# --- mnttab: map the scratch path to its disk device (Solaris) ----------
if try <<'EOF'
#include <stdio.h>
#include <sys/mnttab.h>
int main() { struct mnttab m; FILE *f = fopen("/etc/mnttab", "r");
             return f ? getmntent(f, &m) : 1; }
EOF
then have HAVE_MNTTAB "mnttab (disk device lookup)"
else lack "" "mnttab (disk device lookup)"; fi

# --- popen: shell out to iostat -En for the SCSI drive model ------------
if try <<'EOF'
#include <stdio.h>
int main() { FILE *p = popen("echo", "r"); return p ? pclose(p) : 1; }
EOF
then have HAVE_POPEN "popen (drive model via iostat)"
else lack "" "popen (drive model via iostat)"; fi

# --- termios: raw-mode keyboard for the interactive menu ----------------
if try <<'EOF'
#include <termios.h>
#include <unistd.h>
int main() { struct termios t; return tcgetattr(0, &t); }
EOF
then have HAVE_TERMIOS "termios (interactive keys)"
else lack "" "termios (interactive keys)"; fi

# --- <malloc.h> (SunOS 4 keeps valloc there) ----------------------------
if try <<'EOF'
#include <malloc.h>
int main() { return 0; }
EOF
then have HAVE_MALLOC_H "<malloc.h>"
else lack "" "<malloc.h>"; fi

emit "#endif /* SUNBENCH_CONFIG_H */"
echo "wrote $OUT"

# --- socket linkage: does the network code need -lsocket -lnsl? ---------
# SunOS 4 and modern systems have sockets in libc; Solaris 2.x needs the
# classic pair.  We only print the hint -- NETLIBS stays a make variable.
cat > ${T}.c <<'EOF'
#include <sys/types.h>
#include <sys/socket.h>
#include <netdb.h>
int main() { (void)gethostbyname("x"); return socket(2, 1, 0) < 0; }
EOF
if $CC $CFLAGS -o ${T} ${T}.c >/dev/null 2>&1; then
    echo "  sockets in libc: yes"
elif $CC $CFLAGS -o ${T} ${T}.c -lsocket -lnsl >/dev/null 2>&1; then
    echo "  sockets in libc: no (need -lsocket -lnsl)"
    echo ""
    echo "note: this system needs the socket libraries spelled out;"
    echo "      build with:   make NETLIBS='-lsocket -lnsl'"
    echo "      (and:         make netd NETLIBS='-lsocket -lnsl')"
    echo ""
else
    echo "  sockets in libc: none (network module builds as stubs)"
fi

# --- fleet-build hint: does the compiler accept -mcpu=v7? ---------------
# A V7 build runs on sun4c (SPARCstation 1/IPC/IPX) as well as sun4m/sun4u.
echo 'int main(){return 0;}' > ${T}.c
if $CC -mcpu=v7 -c ${T}.c -o ${T}.o >/dev/null 2>&1; then
    echo ""
    echo "note: for a binary that must run on sun4c (SPARCstation 1/IPC/IPX),"
    echo "      build with:   make CC=$CC MCPU=-mcpu=v7"
fi
rm -f ${T}.o
